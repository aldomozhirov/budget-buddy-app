{
  "name": "budget-buddy",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.10.1",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @budget-buddy/server --filter @budget-buddy/web dev",
    "build": "pnpm --filter @budget-buddy/shared build && pnpm --filter @budget-buddy/web build && pnpm --filter @budget-buddy/server build",
    "typecheck": "pnpm --filter @budget-buddy/shared build && pnpm --filter @budget-buddy/shared typecheck && pnpm --filter @budget-buddy/server typecheck && pnpm --filter @budget-buddy/web typecheck",
    "lint": "eslint .",
    "test": "node scripts/test.mjs",
    "e2e": "VITE_COMPONENT_GALLERY=true pnpm build && node scripts/e2e.mjs",
    "format": "prettier --write .",
    "prepare": "node scripts/prepare.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.10.0",
    "@playwright/test": "^1.63.0",
    "eslint": "^10.12.0",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^17.4.0",
    "prettier": "^3.6.2",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.58.0",
    "vitest": "^5.0.3"
  }
}
