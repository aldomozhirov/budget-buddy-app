#!/usr/bin/env bash
# Build spec tasks unattended: one OpenCode build session per task, in order.
# A task whose session ends unfinished gets a new session that continues it;
# the run stops when a task is still unfinished after the allowed attempts.

set -u

SPEC="docs/specs/01-foundation-and-wealth.md"
MODEL=""
ATTEMPTS=3
DRY_RUN=0
SELECTORS=()

usage() {
  cat <<'EOF'
Usage: scripts/build-tasks <tasks>... [options]

Tasks:
  6-9          a range
  4 5 12       single tasks
  B            every task of milestone B
  Any mix works: scripts/build-tasks 4 5 B 10-12

Options:
  --spec <file>    spec to build from (default: docs/specs/01-foundation-and-wealth.md)
  --model <model>  model for the build agent, e.g. openai/gpt-6.1-sol#high
                   (default: the model and effort in .opencode/agents/build.md)
  --attempts <n>   sessions allowed per task before the run stops (default: 3)
  --dry-run        show what would be built and stop
  -h, --help       show this help

Tasks already ticked are skipped, so the same command resumes a stopped run.
Logs go to .data/build-logs/.
EOF
}

die() {
  echo "build-tasks: $*" >&2
  exit 1
}

while [ $# -gt 0 ]; do
  case "$1" in
    --spec) [ $# -ge 2 ] || die "--spec needs a file"; SPEC="$2"; shift 2 ;;
    --model) [ $# -ge 2 ] || die "--model needs a value"; MODEL="$2"; shift 2 ;;
    --attempts) [ $# -ge 2 ] || die "--attempts needs a number"; ATTEMPTS="$2"; shift 2 ;;
    --dry-run) DRY_RUN=1; shift ;;
    -h | --help) usage; exit 0 ;;
    -*) die "unknown option $1 (see --help)" ;;
    *) SELECTORS+=("$1"); shift ;;
  esac
done

[ ${#SELECTORS[@]} -gt 0 ] || { usage; exit 1; }
[[ "$ATTEMPTS" =~ ^[1-9][0-9]*$ ]] || die "--attempts must be 1 or more"

cd "$(git -C "$(dirname "$0")" rev-parse --show-toplevel)" || die "not in a git repository"
[ -f "$SPEC" ] || die "spec not found: $SPEC"
# Non-interactive shells (ssh commands, cron, launchd) skip ~/.zshrc, where
# the OpenCode installer puts its PATH entry.
command -v opencode >/dev/null || PATH="$HOME/.opencode/bin:$PATH"
command -v opencode >/dev/null || die "opencode not found on PATH or in ~/.opencode/bin"

is_task() { grep -q "^- \[[ x]\] \*\*$1\. " "$SPEC"; }
is_done() { grep -q "^- \[x\] \*\*$1\. " "$SPEC"; }
title_of() { sed -n "s/^- \[[ x]\] \*\*$1\. \(.*\)\*\*.*/\1/p" "$SPEC" | sed 's/\.$//'; }

milestone_tasks() {
  awk -v m="$1" '
    /^### Milestone / { inside = ($3 == m ":") }
    /^## / { inside = 0 }
    inside && /^- \[[ x]\] \*\*[0-9]+\. / { n = $0; sub(/^- \[[ x]\] \*\*/, "", n); sub(/\..*/, "", n); print n }
  ' "$SPEC"
}

# Task numbers on the "Depends:" line of a task; "all" means every other task.
depends_of() {
  local line
  line=$(awk -v t="$1" '
    /^- \[[ x]\] \*\*[0-9]+\. / { n = $0; sub(/^- \[[ x]\] \*\*/, "", n); sub(/\..*/, "", n); inside = (n == t) }
    inside && /Depends:/ { print; exit }
  ' "$SPEC" | sed -e 's/.*Depends: //' -e 's/Parallel:.*//' -e 's/\. .*//')
  if echo "$line" | grep -qw "all"; then
    grep -o "^- \[[ x]\] \*\*[0-9]*\. " "$SPEC" | grep -o "[0-9]\+" | grep -vx "$1"
  else
    echo "$line" | grep -o "[0-9]\+"
  fi
}

TASKS=()
for sel in "${SELECTORS[@]}"; do
  if [[ "$sel" =~ ^[0-9]+$ ]]; then
    TASKS+=("$sel")
  elif [[ "$sel" =~ ^([0-9]+)-([0-9]+)$ ]]; then
    [ "${BASH_REMATCH[1]}" -le "${BASH_REMATCH[2]}" ] || die "range $sel runs backwards"
    for ((t = BASH_REMATCH[1]; t <= BASH_REMATCH[2]; t++)); do TASKS+=("$t"); done
  elif [[ "$sel" =~ ^[A-Za-z]$ ]]; then
    letter=$(echo "$sel" | tr '[:lower:]' '[:upper:]')
    found=$(milestone_tasks "$letter")
    [ -n "$found" ] || die "no milestone $letter in $SPEC"
    for t in $found; do TASKS+=("$t"); done
  else
    die "cannot read '$sel' as a task, a range or a milestone letter"
  fi
done

for t in "${TASKS[@]}"; do
  is_task "$t" || die "no task $t in $SPEC"
done
# Build in spec order, each task once.
TASKS=($(printf '%s\n' "${TASKS[@]}" | sort -n -u))

# `opencode run` does not apply the agent's own model, so pass it explicitly.
if [ -z "$MODEL" ]; then
  AGENT_FILE=".opencode/agents/build.md"
  MODEL=$(sed -n 's/^model: *//p' "$AGENT_FILE" | head -1)
  EFFORT=$(sed -n 's/^reasoningEffort: *//p' "$AGENT_FILE" | head -1)
  [ -n "$MODEL" ] || die "no model in $AGENT_FILE; pass --model"
  [ -n "$EFFORT" ] && MODEL="$MODEL#$EFFORT"
fi

echo "Spec: $SPEC"
echo "Model: $MODEL"
echo "Plan:"
TODO=0
for t in "${TASKS[@]}"; do
  if is_done "$t"; then
    printf "  %3s  done   %s\n" "$t" "$(title_of "$t")"
  else
    printf "  %3s  build  %s\n" "$t" "$(title_of "$t")"
    TODO=$((TODO + 1))
  fi
done

[ "$TODO" -gt 0 ] || { echo "Nothing to build."; exit 0; }
[ "$DRY_RUN" -eq 1 ] && exit 0

# Untracked files that are here before the run are not a task's work.
BASELINE=$(git ls-files --others --exclude-standard)

# Uncommitted changes, without the untracked files of BASELINE.
dirty() {
  git status --porcelain --untracked-files=no
  git ls-files --others --exclude-standard | grep -vxF -f <(echo "$BASELINE") | sed 's/^/?? /'
}

if [ -n "$BASELINE" ]; then
  echo "Note: ignoring untracked files that were here before the run:"
  echo "$BASELINE" | sed 's/^/  /'
fi
if [ -n "$(dirty)" ]; then
  echo "Note: the working tree has uncommitted changes; the first task will continue from them."
fi

# Keep the Mac awake for as long as this script runs.
command -v caffeinate >/dev/null && caffeinate -i -w $$ &

LOG_DIR=".data/build-logs/$(date +%Y%m%d-%H%M%S)"
mkdir -p "$LOG_DIR"
echo "Logs: $LOG_DIR"

RUN_START=$(date +%s)
BUILT=()
STOP_REASON=""

minutes() { echo "$((($(date +%s) - $1) / 60)) min"; }

summary() {
  echo
  echo "── Run ended $(date '+%Y-%m-%d %H:%M'), $(minutes "$RUN_START") ──"
  echo "Built: ${BUILT[*]:-none}"
  [ -n "$STOP_REASON" ] && echo "Stopped: $STOP_REASON"
  echo "Logs: $LOG_DIR"
}

trap 'STOP_REASON="interrupted"; summary; exit 130' INT TERM

BLOCKED_RULE="If you cannot finish because the task needs the owner, real devices or a correction to the spec, end your reply with one line starting with 'BLOCKED:' and the reason."

continue_prompt() {
  echo "Continue task $1 of $SPEC. An earlier session ended before the task was finished: $2. Its work is in the working tree and in the latest commits; read git status and git diff first, keep what is sound, then finish the task through tester, reviewer, commit and push."
}

# Why task $1 is not finished; empty when it is ticked, committed and pushed.
unfinished() {
  if ! is_done "$1"; then
    echo "it is not ticked in the spec"
  elif [ -n "$(dirty)" ]; then
    echo "it is ticked but has uncommitted changes: $(dirty | head -5 | tr '\n' ' ')"
  elif [ -n "$(git log --oneline '@{upstream}..HEAD' 2>/dev/null)" ]; then
    echo "it is committed but not pushed"
  fi
}

for t in "${TASKS[@]}"; do
  is_done "$t" && continue

  for dep in $(depends_of "$t"); do
    if ! is_done "$dep"; then
      STOP_REASON="task $t depends on task $dep, which is not done"
      break 2
    fi
  done

  echo
  echo "── Task $t: $(title_of "$t") ── $(date '+%H:%M')"
  TASK_START=$(date +%s)
  PROMPT="Build task $t of $SPEC."
  # Leftovers of a stopped run: continue from them instead of starting over.
  [ -n "$(dirty)" ] && PROMPT=$(continue_prompt "$t" "it left uncommitted changes")
  attempt=1
  while :; do
    LOG="$LOG_DIR/task-$t-attempt-$attempt.log"
    opencode run --agent build --auto --title "Task $t, attempt $attempt" --model "$MODEL" \
      "$PROMPT $BLOCKED_RULE" 2>&1 | tee "$LOG"

    PROBLEM=$(unfinished "$t")
    [ -z "$PROBLEM" ] && break
    if grep -q "^[^[:alpha:]]*BLOCKED:" "$LOG"; then
      STOP_REASON="task $t is blocked: $(grep -m1 "^[^[:alpha:]]*BLOCKED:" "$LOG" | sed 's/.*BLOCKED: *//') (see $LOG)"
      break 2
    fi
    if [ "$attempt" -ge "$ATTEMPTS" ]; then
      STOP_REASON="task $t: $PROBLEM after $attempt attempts (see $LOG)"
      break 2
    fi
    echo "── Task $t: $PROBLEM; starting attempt $((attempt + 1)) of $ATTEMPTS ──"
    attempt=$((attempt + 1))
    PROMPT=$(continue_prompt "$t" "$PROBLEM")
  done

  BUILT+=("$t")
  echo "── Task $t done in $(minutes "$TASK_START") ──"
done

summary
[ -z "$STOP_REASON" ]
