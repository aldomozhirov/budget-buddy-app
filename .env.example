# Copy to .env for local development. Defaults are safe for a local-only server.
# Web addresses allowed to send changes; separate several with commas,
# e.g. http://127.0.0.1:5173,https://<host>.<tailnet>.ts.net:5443
APP_ORIGIN=http://127.0.0.1:5173
HOST=127.0.0.1
PORT=3000
DATA_DIR=../.data
BACKUP_DIR=../.backups
RATES_FEED=fixture
